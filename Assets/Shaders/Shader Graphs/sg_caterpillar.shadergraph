{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "e05906136648418d8b5290bdc94000c9",
    "m_Title": "Non Linear Sine Wave",
    "m_Content": "To simulate asymetrical breathing, so the caterpillar breathes in slower than breathing out, I skew the sign wave to bias the left side.\n\nThe B input of the divide is the variable that controls the bias ",
