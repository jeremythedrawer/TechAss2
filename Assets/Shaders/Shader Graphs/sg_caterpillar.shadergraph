{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "47388ca379214df491a2d0366319ada1",
    "m_Title": "Normal Direction",
    "m_Content": "I add the vertex offsets to the normal vector then add the output to the vertex positions to allow the vertices to move along its normals. I multiply by 0.1 so the effect isn't too strong",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -90.0,
