{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "adc5c3ea9c0345d6865317b755dc3ec6",
    "m_Title": "Centroid",
    "m_Content": "To move the (0,0) coord to the center of each triangle, I average each vertex of the triangle. The coords of the triangle points are:\nvec2(0), vec2(triangle grid - const1), vec2(const2).\n\nI ignore vec2(0), but thats why it is divided by 3 and not 2. \n\nLike previous calculations the current UV is subtracted and now the origin is the centre.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -3541.0,
        "y": 1013.0,
        "width": 200.0,
        "height": 226.0
    },
    "m_Group": {
        "m_Id": "3ddd8d1339dd45c682571dff167f3c70"
    }
}

