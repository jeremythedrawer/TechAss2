{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "6fdb05ac524245c2a03554fd408039d0",
    "m_Title": "Complete Rhombus Shape",
    "m_Content": "The kernels need to be \"unskewed\" from square to triangle lattice points so they can be calculated in the original UV space. The second simplex constant is multiplied by the skewed coordinates and subtracted by the skewed UV that was previously added. It is subtracted one more time by the base UV to create a rhombus tile pattern, where each rhombus is a value between 0-1.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -4881.0,
        "y": 484.0,
        "width": 270.0,
        "height": 178.0
    },
    "m_Group": {
        "m_Id": "71ffcc2ca37b4430aa75a7dad733219b"
    }
}

