{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "44927e408b784fabbc58113189d4d4cb",
    "m_Title": "ID system",
    "m_Content": "To target each triangle, I get the triangle grid uv and multiply with the floored rhombus UV to target each triangle. I pass that through a simple noise which generates a random ID between 0-1 for each triangle.\n\nFrom there I provide an example of a usage which is squishing each triangle.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -2123.0,
        "y": 1460.0,
        "width": 200.0,
        "height": 160.0
    },
    "m_Group": {
        "m_Id": "4ea43babbe1c47bfa965507278efcf4b"
    }
}

